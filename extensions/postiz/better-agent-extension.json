{
  "kind": "better-agent-extension",
  "id": "ofek-dev.postiz",
  "name": "Postiz",
  "version": "0.1.0",
  "description": "Manage Postiz integrations, posts, media, and analytics through the Postiz agents CLI.",
  "surfaces": [
    "runtime_mcp"
  ],
  "entrypoints": {
    "mcp": [
      {
        "name": "postiz",
        "python": "mcp/server.py",
        "args": [],
        "env": {},
        "user_facing": true,
        "bare_allowed": false,
        "requires_backend_auth": true
      }
    ],
    "settings": [
      {
        "key": "auth_mode",
        "label": "Authentication mode",
        "type": "string",
        "default": "oauth",
        "enum": [
          "oauth",
          "api_key"
        ],
        "help": "Use OAuth credentials created by postiz auth:login, or a Postiz API key."
      },
      {
        "key": "api_key",
        "label": "API key",
        "type": "secret",
        "help": "Used only when authentication mode is api_key."
      },
      {
        "key": "api_url",
        "label": "API URL",
        "type": "string",
        "default": "https://api.postiz.com",
        "help": "HTTPS Postiz endpoint, or HTTP on a literal loopback host for local self-hosting."
      }
    ]
  },
  "permissions": {
    "internal_loopback": true
  },
  "marketplace": {},
  "protocol": {
    "version": 1,
    "smoke_test": {
      "required_paths": [
        "better-agent-extension.json",
        "mcp/server.py"
      ],
      "python_modules": [
        "mcp.server"
      ]
    }
  }
}
