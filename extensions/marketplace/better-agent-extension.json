{
  "kind": "better-agent-extension",
  "id": "ofek-dev.marketplace",
  "name": "Marketplace",
  "version": "0.1.0",
  "description": "Private extension marketplace surface and catalog bridge.",
  "surfaces": [
    "frontend_feature",
    "backend_feature"
  ],
  "entrypoints": {
    "frontend": "ui/index.html",
    "frontend_modules": [
      {
        "slot": "settings",
        "id": "marketplace",
        "label": "Marketplace",
        "kind": "iframe",
        "module": "ui/index.html"
      }
    ],
    "mcp": [],
    "provider_capabilities": [],
    "backend_module": "backend.routes"
  },
  "permissions": {
    "backend_routes": true,
    "internal_loopback": true,
    "network": true,
    "marketplace_auth": true,
    "payments": true,
    "capabilities": [
      "marketplace.auth-secret.list",
      "marketplace.auth-secret.get",
      "marketplace.auth-secret.store",
      "marketplace.auth-secret.delete"
    ]
  },
  "marketplace": {
    "product_id": "",
    "subscription_required": false,
    "entitlement_url": ""
  },
  "protocol": {
    "version": 1,
    "smoke_test": {
      "required_paths": [
        "better-agent-extension.json",
        "ui/index.html"
      ],
      "python_modules": [
        "backend.routes"
      ]
    }
  }
}
